# Server only. Never put these credentials in NEXT_PUBLIC_* variables.
DATABASE_URL=
DIRECT_URL=
HOST=127.0.0.1
PORT=3100
DEMO_ENABLED=false
# Enable only for disposable local fixture testing. Production startup rejects true.
MERCHANT_FIXTURE_LOGIN_ENABLED=false
# App ID is public. App secret is server-only; SDK discovers public signing keys.
PRIVY_APP_ID=
# Configure the app secret OR an optional PEM public signing key override.
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
SUI_PAYMENT_NETWORK=testnet
TATUM_API_KEY=
DEMO_SUI_PAYER_ADDRESS=
DEMO_SUI_RECIPIENT_ADDRESS=
SUI_SIGNER_REF=
MEMWAL_NETWORK=testnet
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_NAMESPACE=morrow-foundation-v1
# Existing server-only OpenRouter key; model must end in :free. No paid fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Explicit disposable test database only, never a production database.
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=

# Keep true behind HTTPS. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true
