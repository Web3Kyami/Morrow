# Server only. Never put these credentials in NEXT_PUBLIC_* variables.
DATABASE_URL=
DIRECT_URL=
HOST=127.0.0.1
PORT=3100
DEMO_ENABLED=false
SUI_PAYMENT_NETWORK=testnet
TATUM_API_KEY=
DEMO_SUI_PAYER_ADDRESS=
DEMO_SUI_RECIPIENT_ADDRESS=
SUI_SIGNER_REF=
MEMWAL_NETWORK=testnet
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_NAMESPACE=morrow-foundation-v1
# Existing server-only OpenRouter key; model must end in :free. No paid fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Explicit disposable test database only, never a production database.
TEST_DATABASE_URL=
TEST_RUNTIME_DATABASE_URL=

# Keep true behind HTTPS. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true
